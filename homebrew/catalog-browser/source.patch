diff --git a/tools/test-catalog-browser.js b/tools/test-catalog-browser.js
new file mode 100644
index 0000000..247eee9
--- /dev/null
+++ b/tools/test-catalog-browser.js
@@ -0,0 +1,93 @@
+var assert = require('assert');
+var catalog = require('../frontend/catalog-browser');
+
+function testVersions() {
+  assert.strictEqual(catalog.compareVersions('1.0.10', '1.0.9c'), 1);
+  assert.strictEqual(catalog.compareVersions('1.0.9c', '1.0.9'), -1);
+  assert.strictEqual(catalog.compareVersions('1.0.9.2', '1.0.9.1'), 1);
+  assert.strictEqual(catalog.compareVersions('2.0.0', '10.0.0'), -1);
+  assert.strictEqual(catalog.compareVersions('1.2.0', '1.2'), 0);
+  assert.strictEqual(catalog.compareVersions('1.2.3', '1.2.3-rc.9'), 1);
+  assert.strictEqual(catalog.compareVersions('1.2.3-alpha.10', '1.2.3-alpha.2'), 1);
+  assert.strictEqual(catalog.compareVersions('1.2.3-alpha.2', '1.2.3-alpha.beta'), -1);
+  assert.strictEqual(catalog.compareVersions('1.2.3+build.2', '1.2.3+build.1'), 0);
+  assert.strictEqual(catalog.compareVersions('1.x', '1.0'), null);
+  assert.strictEqual(catalog.compareVersions('1..2', '1.0'), null);
+  assert.strictEqual(catalog.compareVersions('1.2.3-', '1.2.3'), null);
+}
+
+function sampleRows() {
+  return [
+    {uid: 'app|repo-a', id: 'app', title: 'Alpha', repository: 'https://github.com/owner/repo-a', manifest: {version: '2.0'}},
+    {uid: 'app|repo-b', id: 'app', title: 'Alpha', repository: 'https://github.com/owner/repo-b', manifest: {version: '1.0'}},
+    {uid: 'other|repo-a', id: 'other', title: 'Beta Tool', repository: 'https://example.org/apps', manifest: {version: '1.0'}},
+  ];
+}
+
+function testDecorationAndSelection() {
+  var rows = catalog.decorate(sampleRows(), {
+    app: {known: true, version: '1.0'},
+    other: {known: true, version: null},
+  }, {'app|repo-a': true});
+  assert.deepStrictEqual(rows.map(function (row) { return row.status; }), ['update', 'installed', 'available']);
+  assert.strictEqual(rows[0].installedVersion, '1.0');
+  assert.ok(rows[0].infoText.indexOf('New') !== -1);
+  assert.strictEqual(rows[0].repoLabel, 'owner/repo-a');
+  assert.strictEqual(catalog.decorate([sampleRows()[0]], {}, [])[0].status, 'unknown');
+
+  assert.strictEqual(catalog.select(rows, {mode: 'updates'}).length, 1);
+  assert.strictEqual(catalog.select(rows, {mode: 'installed'}).length, 2);
+  assert.strictEqual(catalog.select(rows, {mode: 'new'}).length, 1);
+  assert.strictEqual(catalog.select(rows, {query: 'repo-b'}).length, 1);
+  assert.strictEqual(catalog.select(rows, {query: 'beta'}).length, 1);
+  assert.strictEqual(catalog.select(rows, {repo: 'https://github.com/owner/repo-b'}).length, 1);
+  assert.deepStrictEqual(catalog.select(rows, {}).map(function (row) { return row.uid; }), ['app|repo-a', 'app|repo-b', 'other|repo-a']);
+  assert.deepStrictEqual(catalog.select(rows, {descending: true}).map(function (row) { return row.title; }), ['Beta Tool', 'Alpha', 'Alpha']);
+  assert.deepStrictEqual(catalog.counts(rows), {all: 3, updates: 1, installed: 1, newlyDiscovered: 1});
+
+  var duplicateRows = catalog.decorate([
+    sampleRows()[0],
+    {uid: 'app|repo-c', id: 'app', title: 'Alpha duplicate', repository: 'https://example.org', manifest: {version: '3.0'}},
+  ], {app: {known: true, version: '1.0'}}, {'app|repo-a': true, 'app|repo-c': true});
+  assert.deepStrictEqual(catalog.counts(duplicateRows), {all: 2, updates: 1, installed: 1, newlyDiscovered: 1});
+  assert.strictEqual(catalog.repoLabel('https://raw.githubusercontent.com/owner/repo/main/repo.json'), 'owner/repo');
+}
+
+function memoryStorage(initial) {
+  var values = initial || {};
+  return {
+    values: values,
+    getItem: function (key) { return values[key] || null; },
+    setItem: function (key, value) { values[key] = value; },
+  };
+}
+
+function testDiscoveryTracker() {
+  var storage = memoryStorage();
+  var first = catalog.createTracker(storage);
+  assert.deepStrictEqual(first.observe([{uid: 'a'}]), {});
+  assert.deepStrictEqual(first.observe([{uid: 'b'}]), {});
+
+  var nextVisit = catalog.createTracker(storage);
+  assert.deepStrictEqual(nextVisit.observe([{uid: 'a'}, {uid: 'b'}, {uid: 'c'}]), {c: true});
+  assert.deepStrictEqual(nextVisit.observe([{uid: 'a'}, {uid: 'b'}, {uid: 'c'}, {uid: 'd'}]), {c: true, d: true});
+
+  var followingVisit = catalog.createTracker(storage);
+  assert.deepStrictEqual(followingVisit.observe([{uid: 'a'}, {uid: 'b'}, {uid: 'c'}, {uid: 'd'}]), {});
+}
+
+function testStorageFailure() {
+  var broken = {
+    getItem: function () { throw new Error('unavailable'); },
+    setItem: function () { throw new Error('unavailable'); },
+  };
+  var tracker = catalog.createTracker(broken);
+  assert.doesNotThrow(function () { tracker.observe([{uid: 'first'}]); });
+  assert.deepStrictEqual(tracker.observe([{uid: 'second'}]), {});
+}
+
+testVersions();
+testDecorationAndSelection();
+testDiscoveryTracker();
+testStorageFailure();
+console.log('catalog-browser helpers passed');
