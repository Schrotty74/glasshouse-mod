new file mode 100644
index 0000000..0db92ef
--- /dev/null
+++ b/frontend/catalog-browser.js
@@ -0,0 +1,226 @@
+// Small ES5-only helpers for the Homebrew Channel catalog browser.
+
+var TRACKER_KEY = 'catalogBrowserSeen.v1';
+
+function parseVersion(version) {
+  if (typeof version !== 'string') return null;
+  var match = /^(\d+(?:\.\d+)*(?:[A-Za-z][A-Za-z0-9-]*)?)(?:-([0-9A-Za-z.-]+))?(?:\+([0-9A-Za-z.-]+))?$/.exec(version);
+  if (!match) return null;
+  var parts = match[1].split('.');
+  var numbers = [];
+  var prerelease = match[2] ? match[2].split('.') : [];
+  var build = match[3] ? match[3].split('.') : [];
+  var i;
+  for (i = 0; i < parts.length; i++) {
+    var match = /^(\d+)([A-Za-z][A-Za-z0-9]*)?$/.exec(parts[i]);
+    if (!match) return null;
+    numbers.push(match[1].replace(/^0+(?=\d)/, ''));
+    if (match[2]) {
+      if (i !== parts.length - 1) return null;
+      if (prerelease.length) return null;
+      prerelease.push(match[2]);
+    }
+  }
+  for (i = 0; i < prerelease.length; i++) {
+    if (!prerelease[i]) return null;
+  }
+  for (i = 0; i < build.length; i++) {
+    if (!build[i]) return null;
+  }
+  while (numbers.length > 1 && numbers[numbers.length - 1] === '0') numbers.pop();
+  return {numbers: numbers, prerelease: prerelease, build: build};
+}
+
+function compareNumericStrings(left, right) {
+  var a = String(left).replace(/^0+(?=\d)/, '');
+  var b = String(right).replace(/^0+(?=\d)/, '');
+  if (a.length !== b.length) return a.length > b.length ? 1 : -1;
+  return a > b ? 1 : a < b ? -1 : 0;
+}
+
+function compareVersions(available, installed) {
+  var a = parseVersion(available);
+  var b = parseVersion(installed);
+  if (!a || !b) return null;
+  var length = Math.max(a.numbers.length, b.numbers.length);
+  var i;
+  for (i = 0; i < length; i++) {
+    var comparison = compareNumericStrings(i < a.numbers.length ? a.numbers[i] : '0', i < b.numbers.length ? b.numbers[i] : '0');
+    if (comparison) return comparison;
+  }
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  for (i = 0; i < Math.max(a.prerelease.length, b.prerelease.length); i++) {
+    if (i >= a.prerelease.length) return -1;
+    if (i >= b.prerelease.length) return 1;
+    var left = a.prerelease[i];
+    var right = b.prerelease[i];
+    var leftNumeric = /^\d+$/.test(left);
+    var rightNumeric = /^\d+$/.test(right);
+    if (leftNumeric && rightNumeric) comparison = compareNumericStrings(left, right);
+    else if (leftNumeric) comparison = -1;
+    else if (rightNumeric) comparison = 1;
+    else comparison = left > right ? 1 : left < right ? -1 : 0;
+    if (comparison) return comparison;
+  }
+  return 0;
+}
+
+function repoLabel(url) {
+  if (typeof url !== 'string' || !url) return '';
+  var match = /^https?:\/\/([^/]+)(\/.*)?$/i.exec(url);
+  if (!match) return url;
+  var host = match[1].toLowerCase();
+  var path = (match[2] || '').replace(/\/$/, '');
+  if (host === 'github.com' || host === 'raw.githubusercontent.com') {
+    var segments = path.split('/').slice(1);
+    if (segments.length >= 2 && segments[0] && segments[1]) return segments[0] + '/' + segments[1];
+  }
+  return host + path;
+}
+
+function decorate(entries, inventory, newKeys) {
+  inventory = inventory || {};
+  newKeys = newKeys || {};
+  return (entries || []).map(function (entry) {
+    var row = {};
+    var key;
+    for (key in entry) {
+      if (Object.prototype.hasOwnProperty.call(entry, key)) row[key] = entry[key];
+    }
+    var record = inventory[row.id];
+    var known = !!(record && record.known === true);
+    var installedVersion = known && typeof record.version === 'string' ? record.version : null;
+    var availableVersion = row.manifest && typeof row.manifest.version === 'string' ? row.manifest.version : null;
+    var comparison = installedVersion && availableVersion ? compareVersions(availableVersion, installedVersion) : null;
+    var status = 'unknown';
+    if (known) {
+      if (installedVersion && comparison === 1) status = 'update';
+      else if (installedVersion) status = 'installed';
+      else status = 'available';
+    }
+    var label = repoLabel(row.repository || '');
+    var isNew = !!newKeys[row.uid];
+    var info = availableVersion ? 'Available ' + availableVersion : 'Version unknown';
+    if (status === 'update') info += ' (installed ' + installedVersion + ')';
+    else if (status === 'installed') info += ' (installed)';
+    else if (status === 'available') info += ' (not installed)';
+    else info += ' (install status unknown)';
+    if (isNew) info += ' - New';
+    if (label) info += ' - ' + label;
+    row.status = status;
+    row.installedVersion = installedVersion;
+    row.repoLabel = label;
+    row.newlyDiscovered = isNew;
+    row.infoText = info;
+    return row;
+  });
+}
+
+function lower(value) {
+  return value === null || value === undefined ? '' : String(value).toLowerCase();
+}
+
+function select(rows, options) {
+  options = options || {};
+  var mode = options.mode || 'all';
+  var query = lower(options.query).replace(/^\s+|\s+$/g, '');
+  var repository = options.repo || '';
+  var selected = (rows || []).filter(function (row) {
+    if (mode === 'updates' && row.status !== 'update') return false;
+    if (mode === 'installed' && row.status !== 'installed' && row.status !== 'update') return false;
+    if (mode === 'new' && !row.newlyDiscovered) return false;
+    if (repository && row.repository !== repository) return false;
+    if (query) {
+      var searchable = [row.title, row.id, row.repository, row.repoLabel].map(lower).join(' ');
+      if (searchable.indexOf(query) === -1) return false;
+    }
+    return true;
+  });
+  selected.sort(function (left, right) {
+    var a = lower(left.title);
+    var b = lower(right.title);
+    var comparison = a < b ? -1 : a > b ? 1 : 0;
+    if (comparison && options.descending) comparison = -comparison;
+    if (!comparison) {
+      a = lower(left.uid);
+      b = lower(right.uid);
+      comparison = a < b ? -1 : a > b ? 1 : 0;
+    }
+    return comparison;
+  });
+  return selected;
+}
+
+function counts(rows) {
+  var unique = {updates: {}, installed: {}, newlyDiscovered: {}};
+  var result = {all: (rows || []).length, updates: 0, installed: 0, newlyDiscovered: 0};
+  (rows || []).forEach(function (row) {
+    var id = row.id || row.uid;
+    if (row.status === 'update') unique.updates[id] = true;
+    if (row.status === 'installed' || row.status === 'update') unique.installed[id] = true;
+    if (row.newlyDiscovered) unique.newlyDiscovered[id] = true;
+  });
+  Object.keys(unique.updates).forEach(function (id) { result.updates++; });
+  Object.keys(unique.installed).forEach(function (id) { result.installed++; });
+  Object.keys(unique.newlyDiscovered).forEach(function (id) { result.newlyDiscovered++; });
+  return result;
+}
+
+function createTracker(storage) {
+  var seen = {};
+  var newKeys = {};
+  var loaded = false;
+  var baselineExists = false;
+  try {
+    if (storage && typeof storage.getItem === 'function') {
+      var raw = storage.getItem(TRACKER_KEY);
+      if (raw) {
+        var saved = JSON.parse(raw);
+        if (saved && saved.version === 1 && saved.seen && typeof saved.seen === 'object') {
+          seen = saved.seen;
+          baselineExists = true;
+        }
+      }
+    }
+  } catch (err) {
+    seen = {};
+    baselineExists = false;
+  }
+  loaded = true;
+  var compareAgainstBaseline = baselineExists;
+
+  function persist() {
+    try {
+      if (storage && typeof storage.setItem === 'function') {
+        storage.setItem(TRACKER_KEY, JSON.stringify({version: 1, seen: seen}));
+      }
+    } catch (err) {
+      // Storage may be unavailable; this feature must not block catalog use.
+    }
+  }
+
+  return {
+    observe: function (entries) {
+      if (!loaded) return {};
+      (entries || []).forEach(function (entry) {
+        if (!entry || !entry.uid) return;
+        if (compareAgainstBaseline && !seen[entry.uid]) newKeys[entry.uid] = true;
+        seen[entry.uid] = true;
+      });
+      persist();
+      var result = {};
+      Object.keys(newKeys).forEach(function (key) { result[key] = true; });
+      return result;
+    }
+  };
+}
+
+module.exports = {
+  compareVersions: compareVersions,
+  decorate: decorate,
+  select: select,
+  counts: counts,
+  repoLabel: repoLabel,
+  createTracker: createTracker,
+};
